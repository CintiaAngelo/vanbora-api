# Variáveis de ambiente da API VanBora.
#
# Copie para `.env` (ignorado pelo git) e preencha. Nenhum valor real deve ser
# commitado — este arquivo é só um template.
#
# A API lê `backend/.env` sozinha na inicialização (spring.config.import), então
# funciona igual no IntelliJ e no `mvnw spring-boot:run`, sem configurar nada na IDE.
# Variáveis de ambiente de verdade têm precedência sobre o arquivo — é assim que
# produção sobrescreve tudo pelo orquestrador ou por um gerenciador de segredos.
#
# Formato: uma linha `CHAVE=valor` por variável, sem aspas e sem `export`.

# ---------------------------------------------------------------- Ambiente ---
# "development" (default) ou "production". Em production a API se recusa a subir
# com configuração insegura (ver SecurityStartupChecks).
VANBORA_ENV=development

# ---------------------------------------------------------------- Banco -----
DB_URL=jdbc:mysql://localhost:3306/vanbora?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=vanbora
# Obrigatório — a API não sobe sem isso.
DB_PASSWORD=

# ---------------------------------------------------------------- JWT -------
# Gere um valor aleatório longo (>= 32 caracteres). Ex.:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
VANBORA_JWT_SECRET=
VANBORA_JWT_EXPIRATION=86400000

# ---------------------------------------------------------------- CORS ------
# Em produção, os domínios reais separados por vírgula (sem localhost/curinga).
VANBORA_CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------- Rate limiting ------
VANBORA_RATE_LIMIT_ENABLED=true
VANBORA_RATE_LIMIT_AUTH=20
VANBORA_RATE_LIMIT_WRITE=120
VANBORA_RATE_LIMIT_DEFAULT=300
# Só ligue atrás de um proxy reverso confiável (nginx, ALB, Cloud Run).
VANBORA_RATE_LIMIT_TRUST_PROXY=false
VANBORA_LOGIN_MAX_ATTEMPTS=5
VANBORA_LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------- Login social (Auth0) -----
# Valores públicos (aparecem no app). O CLIENT SECRET do Auth0 não é usado aqui.
AUTH0_DOMAIN=
# Client id(s) aceitos no id_token, separados por vírgula.
AUTH0_AUDIENCE=

# ---------------------------------------------------------------- Dados -----
# Popula usuários de demonstração (senha conhecida). Sempre false em produção.
VANBORA_SEED=true

# ------------------------------------------------------------- Externos -----
# Roteamento real das rotas (opcional): https://openrouteservice.org/dev-dashboard
ORS_API_KEY=
# Gateway de pagamento: "simulated" ou "mercadopago".
VANBORA_PAYMENTS_PROVIDER=simulated
MERCADOPAGO_ACCESS_TOKEN=
